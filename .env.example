# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Beta release intent. Task 1 wires and enforces these in the app and worker.
APP_STAGE="beta"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Provider modes. Beta only ever allows sandbox (Yellow Card, with credentials)
# or simulated. NODE_ENV=production never enables a real provider.
YELLOWCARD_MODE="simulated"
YELLOWCARD_API_KEY=""
YELLOWCARD_API_SECRET=""

# Simulated identity verifier signing secret (local placeholder, not for hosting).
SIMULATED_IDENTITY_SECRET="local-beta-identity-secret-not-for-hosting-0001"

# Simulated Paycrest webhook signature secret (local placeholder, not for hosting).
PAYCREST_SIM_WEBHOOK_SECRET="local-beta-paycrest-secret-not-for-hosting-0001"

# HMAC key for the PostgreSQL rate limiter (test-only placeholder, not for hosting).
RATE_LIMIT_SECRET="local-only-rate-limit-secret-change-me-000001"

# Optional Sentry DSN for error reporting in the hosted beta.
SENTRY_DSN=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:local-beta-only@localhost:5432/v3st_beta"
# Use a separate disposable database/schema once Task 1 adds the test runner.
TEST_DATABASE_URL="postgresql://postgres:local-beta-only@localhost:5432/v3st_beta_test"

# Onchain beta execution: isolated loopback Anvil only (chain 31337, no fork).
# scripts/testnet-start.ts launches it and writes a gitignored manifest under .testnet/.
TESTNET_RPC_URL="http://127.0.0.1:8545"
TESTNET_CHAIN_ID="31337"
# Ephemeral test-only signer for the restricted relayer. Generate locally
# (never commit real keys): node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
TESTNET_SIGNER_PRIVATE_KEY=""

# Optional Base Sepolia (84532) access for the Hydrex verified provider testnet.
# The relayer key must be a fresh testnet-only key: never the local test key and
# never a key that has held mainnet funds. Leave both unset for the local replica.
BASE_SEPOLIA_RPC_URL=""
BASE_SEPOLIA_RELAYER_PRIVATE_KEY=""
# Optional keeper key that keeps each Base Sepolia stand-in pool near its reference
# price. Must be a different fresh testnet-only key (never the relayer, the local
# test key or a public Anvil development key).
BASE_SEPOLIA_KEEPER_PRIVATE_KEY=""

# Customer sign-in (Privy email codes). "simulated" uses a local issuer (CI and
# local development); "sandbox" is a Privy development app and requires the app
# ID and the SPKI PEM verification key from the Privy dashboard. No Privy app
# secret is used. In the Privy dashboard, turn off the app's sign-in allowlist
# so customers can use any email address they can verify.
PRIVY_MODE="simulated"
PRIVY_APP_ID=""
PRIVY_VERIFICATION_KEY=""

# The customer network for this deployment: "testnet" (local replica, CI default)
# or "basesepolia". Customers see stocks, Earn products and cash on that network only.
APP_CUSTOMER_CHAIN="testnet"
