# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# Regenerate the Prisma client for each execution platform
/generated/prisma/

# Yarn is the package manager; keep other local lockfiles on disk
/package-lock.json

# testing
/coverage

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env.*
!.env.example

# Local credentials and machine-specific agent state
.aws/
.codex/
.agents/
.npmrc
*.key
*.p12
*.pfx

# vercel
.vercel

# typescript
*.tsbuildinfo

# foundry build output, local chain state and testnet manifests (never commit keys)
/out/
/cache/
/broadcast/
/.testnet/
*.anvil.json

# idea files
.idea
.vscode/
