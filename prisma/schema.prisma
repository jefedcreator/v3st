// V3ST beta schema. Money is BigInt minor units (kobo for NGN, micro-units for USDC).
// Every table is @@map'ed to snake_case; columns keep Prisma camelCase.

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    user
    operator
}

enum KycStatus {
    none
    verified
    rejected
}

enum EarningsMode {
    unset
    payout
    reinvest
}

enum WalletFamily {
    evm
    solana
}

enum ProviderMode {
    sandbox
    simulated
}

enum ProviderId {
    yellowcard
    paycrest
}

enum SettlementModel {
    partner_float
    direct_chain
}

enum OrderKind {
    deposit
    withdrawal
    earnings_payout
}

enum OrderDirection {
    in
    out
}

enum OrderStatus {
    created
    awaiting_transfer
    received
    funded
    settled
    expired
    refunded
    failed
    funds_collected
    submitted
    paid
    reversed
}

enum HoldReason {
    name_mismatch
    amount_mismatch
    missing_sender
    treasury_short
    float_short
    rate_moved
    screening
    paused
    needs_review
}

enum BankAccountStatus {
    active
    replaced
    rejected
}

enum LedgerOwner {
    user
    treasury
    float
    external
    clearing
    venue
    equity
}

enum TransferPurpose {
    deposit_funding
    payout_collection
    payout_return
    direct_payout_funding
    float_topup
}

enum TransferStatus {
    awaiting_approval
    pending
    submitted
    confirmed
    failed
}

enum TradeSide {
    buy
    sell
}

enum TradePurpose {
    deposit_buy
    retry_buy
    reinvest
    withdrawal_sell
}

enum TradeSource {
    cash
    earnings
    stock
}

enum TradeStatus {
    pending
    submitted
    filled
    failed
}

enum JobStatus {
    pending
    running
    done
    dead
}

enum AlertSeverity {
    info
    warning
    critical
}

enum TreasuryOpKind {
    float_topup
    float_withdrawal
}

enum TreasuryOpStatus {
    planned
    transferring
    awaiting_provider
    complete
    failed
}

enum ReconStatus {
    balanced
    breached
    incomplete
}

enum IntegrationKind {
    local_testnet_replica
    verified_provider_testnet
}

enum CustodyKind {
    application_account
    provider_managed
}

enum AuthKind {
    one_time
    standing
}

enum OperationKind {
    spot
    strategy
}

enum OperationStatus {
    pending
    prepared
    signed
    broadcast
    confirmed
    finalized
    reverted
    failed
    unknown
    needs_review
}

enum StepStatus {
    pending
    prepared
    signed
    broadcast
    confirmed
    reverted
    failed
    unknown
}

enum ObsState {
    pending
    confirmed
    reverted
    unknown
    reorged
}

enum InvestmentStatus {
    quoted
    reserved
    executing
    filled
    partial
    failed
    cancelled
    needs_confirmation
}

enum StrategyPositionState {
    reserved
    executing
    active
    exit_pending
    exited
    needs_review
}

enum ReceiptState {
    estimated
    received_asset
    conversion_pending
    available
    reserved_for_payout
    paid
    reinvested
}

enum RewardSource {
    hydrex_lp_fees
    hydropump_creator_fees
    stonks_distribution
    basestonk_hook_fees
    feel_distribution
    cash_distribution
    sale_gain
    legacy_fixture
}

enum AllocationState {
    reserved
    available
    paid
    reinvested
    released
}

model User {
    id              String       @id @default(cuid())
    // Phone is kept for the operator test sign-in; Privy customers sign in by
    // email and never store a phone number.
    phone           String?      @unique
    email           String?      @unique
    identitySubject String       @unique
    identityMode    ProviderMode
    role            UserRole     @default(user)
    kycStatus       KycStatus    @default(none)
    kycTier         Int          @default(0)
    verifiedName    String?
    kycPersona      String?
    kycProfile      Json?
    kycMode         ProviderMode?
    earningsMode    EarningsMode @default(unset)
    reinvestStockId String?
    // Versioned consent limits attached to the payout/reinvest preference: optional
    // background conversion of reward assets plus fee/FX ceilings for that path.
    earningsConsentVersion    String?
    allowBackgroundConversion Boolean @default(false)
    maxConversionFeeBps       Int?
    maxFxBps                  Int?
    createdAt       DateTime     @default(now())
    updatedAt       DateTime     @updatedAt

    sessions Session[]

    @@map("users")
}

model Session {
    id             String   @id @default(cuid())
    sessionToken   String   @unique
    userId         String
    expires        DateTime
    deviceLabel    String?
    privySessionId String?
    createdAt      DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("sessions")
}

model Wallet {
    id                String       @id @default(cuid())
    userId            String
    family            WalletFamily
    address           String
    providerWalletId  String
    providerMode      ProviderMode
    executionAddress  String?
    deploymentId      String?
    custodyProfileId  String?
    createdAt         DateTime     @default(now())

    executionAccounts ExecutionAccount[]

    @@unique([userId, family])
    @@unique([family, address])
    @@map("wallets")
}

// One execution account per user per network. Chain 31337 additionally mirrors the
// address on Wallet.executionAddress so existing readers keep working.
model ExecutionAccount {
    id               String   @id @default(cuid())
    walletId         String
    wallet           Wallet   @relation(fields: [walletId], references: [id])
    chainId          Int
    deploymentId     String
    address          String
    custodyProfileId String
    createdAt        DateTime @default(now())

    @@unique([walletId, deploymentId])
    @@map("execution_accounts")
}

model TreasuryWallet {
    id               String       @id @default(cuid())
    chain            String       @unique
    address          String
    providerWalletId String
    providerMode     ProviderMode
    createdAt        DateTime     @default(now())

    @@map("treasury_wallets")
}

model BankAccount {
    id            String            @id @default(cuid())
    userId        String
    bankCode      String
    bankName      String
    accountNumber String
    resolvedName  String
    nameMatch     Boolean
    status        BankAccountStatus
    provider      ProviderId
    providerMode  ProviderMode
    createdAt     DateTime          @default(now())

    @@index([userId])
    @@map("bank_accounts")
}

model WithdrawalQuote {
    id            String       @id @default(cuid())
    userId        String
    provider      ProviderId
    providerMode  ProviderMode
    ngnAmount     BigInt
    feeNgn        BigInt
    netNgn        BigInt
    usdAmount     BigInt
    debitUsdc     BigInt
    rateKobo      BigInt
    rateMicroUsd  BigInt
    chain         String
    stockId       String?
    sellQuantity  Decimal? @db.Decimal(78, 0)
    bankAccountId String
    expiresAt     DateTime
    consumedAt    DateTime?
    createdAt     DateTime     @default(now())

    @@index([userId])
    @@map("withdrawal_quotes")
}

model RampOrder {
    id                  String          @id @default(cuid())
    userId              String
    kind                OrderKind
    direction           OrderDirection
    provider            ProviderId
    providerMode        ProviderMode
    settlementModel     SettlementModel
    status              OrderStatus     @default(created)
    holdReason          HoldReason?
    version             Int             @default(0)
    idempotencyKey      String          @unique
    requestHash         String
    providerRef         String?
    ngnAmount           BigInt
    feeNgn              BigInt?
    usdAmount           BigInt?
    lockedUsd           BigInt?
    rateKobo            BigInt?
    rateMicroUsd        BigInt?
    receivedNgn         BigInt?
    netNgn              BigInt?
    debitUsdc           BigInt?
    chain               String?
    stockId             String?
    quoteId             String?         @unique
    sourceBankAccountId String?
    payToBankName       String?
    payToAccountNumber  String?
    payToAccountName    String?
    payToReference      String?
    onchainFundedAt     DateTime?
    destBankCode        String?
    destBankName        String?
    destAccountNumber   String?
    destAccountName     String?
    bankReference       String?
    fundingAddress      String?
    fundingAmount       BigInt?
    expiresAt           DateTime?
    failureReason       String?
    createdAt           DateTime        @default(now())
    updatedAt           DateTime        @updatedAt

    @@unique([provider, providerRef])
    @@index([userId, createdAt])
    @@index([status])
    @@map("ramp_orders")
}

model OrderTransition {
    id         String       @id @default(cuid())
    orderId    String
    fromStatus OrderStatus?
    toStatus   OrderStatus
    holdReason HoldReason?
    actor      String
    reason     String?
    createdAt  DateTime     @default(now())

    @@index([orderId])
    @@map("order_transitions")
}

model LedgerAccount {
    id            String      @id @default(cuid())
    code          String      @unique
    asset         String
    ownerType     LedgerOwner
    userId        String?
    allowNegative Boolean
    createdAt     DateTime    @default(now())

    @@index([userId])
    @@map("ledger_accounts")
}

model LedgerJournal {
    id          String   @id @default(cuid())
    key         String   @unique
    kind        String
    orderId     String?
    requestHash String
    createdAt   DateTime @default(now())

    @@map("ledger_journals")
}

model LedgerEntry {
    id              String   @id @default(cuid())
    journalId       String
    debitAccountId  String
    creditAccountId String
    asset           String
    amount          Decimal  @db.Decimal(78, 0)
    createdAt       DateTime @default(now())

    @@index([debitAccountId])
    @@index([creditAccountId])
    @@map("ledger_entries")
}

model ChainTransfer {
    id                  String          @id @default(cuid())
    key                 String          @unique
    purpose             TransferPurpose
    status              TransferStatus
    chain               String
    token               String
    fromAddress         String
    toAddress           String
    amount              Decimal  @db.Decimal(78, 0)
    orderId             String?
    treasuryOperationId String?
    txHash              String?
    approvals           String[]
    failureReason       String?
    gasAsset            String?
    gasAmount           Decimal? @db.Decimal(78, 0)
    providerMode        ProviderMode
    createdAt           DateTime        @default(now())
    updatedAt           DateTime        @updatedAt

    @@unique([chain, txHash])
    @@index([status])
    @@map("chain_transfers")
}

model Stock {
    id                            String   @id @default(cuid())
    symbol                        String
    assetKey                      String?  @unique
    name                          String
    kind                          String   @default("stock")
    issuer                        String?
    rightsSummary                 String?
    chain                         String
    networkId                     String?
    network                       OnchainNetwork? @relation(fields: [networkId], references: [id])
    tokenAddress                  String
    decimals                      Int
    enabled                       Boolean
    paused                        Boolean  @default(false)
    delisted                      Boolean  @default(false)
    simPriceMicroUsdc             BigInt
    simWeeklyEarningMicroPerShare BigInt
    multiplierWad                 Decimal  @db.Decimal(78, 0) @default(1000000000000000000)
    referencePriceMicroUsd        BigInt?
    referenceBasis                String?
    referenceAsOf                 DateTime?
    provenance                    Json?
    createdAt                     DateTime @default(now())

    @@index([symbol])
    @@map("stocks")
}

model TradeOrder {
    id            String       @id @default(cuid())
    key           String       @unique
    userId        String
    side          TradeSide
    purpose       TradePurpose
    fundsSource   TradeSource
    stockId       String
    orderId       String?
    chain         String
    venueId       String?
    investmentId  String?      @unique
    investment    Investment?  @relation(fields: [investmentId], references: [id])
    amountIn      Decimal      @db.Decimal(78, 0)
    minAmountOut  Decimal?     @db.Decimal(78, 0)
    amountOut     Decimal?     @db.Decimal(78, 0)
    status        TradeStatus  @default(pending)
    failureReason String?
    venueRef      String?
    version       Int          @default(0)
    providerMode  ProviderMode
    createdAt     DateTime     @default(now())
    updatedAt     DateTime     @updatedAt

    @@index([userId])
    @@index([status])
    @@map("trade_orders")
}

model Earning {
    id              String   @id @default(cuid())
    userId          String
    stockId         String?
    week            String
    chain           String
    amountUsdc      BigInt
    harvestedAt     DateTime
    payoutOrderId   String?
    reinvestTradeId String?
    provenance      String   @default("legacy_fixture")
    receiptId       String?
    createdAt       DateTime @default(now())

    @@unique([userId, stockId, week])
    @@unique([receiptId])
    @@index([userId, payoutOrderId])
    @@map("earnings")
}

model WebhookEvent {
    id             String       @id @default(cuid())
    provider       ProviderId
    eventKey       String
    payload        Json
    signatureValid Boolean
    providerMode   ProviderMode
    receivedAt     DateTime     @default(now())
    processedAt    DateTime?

    @@unique([provider, eventKey])
    @@map("webhook_events")
}

model Job {
    id          String    @id @default(cuid())
    kind        String
    subjectId   String
    key         String    @unique
    payload     Json
    status      JobStatus @default(pending)
    runAt       DateTime
    attempts    Int       @default(0)
    maxAttempts Int       @default(10)
    lockedUntil DateTime?
    lockedBy    String?
    rearmAt     DateTime?
    lastError   String?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([status, runAt])
    @@map("jobs")
}

model ScheduleRun {
    name      String
    slot      String
    createdAt DateTime @default(now())

    @@id([name, slot])
    @@map("schedule_runs")
}

model UserEvent {
    seq       BigInt   @id @default(autoincrement())
    userId    String
    type      String
    subjectId String
    status    String?
    createdAt DateTime @default(now())

    @@index([userId, seq])
    @@map("user_events")
}

model OperationalControl {
    scope       String   @id
    paused      Boolean
    reason      String?
    updatedById String?
    updatedAt   DateTime @updatedAt

    @@map("operational_controls")
}

model OperationalAlert {
    id           String        @id @default(cuid())
    kind         String
    severity     AlertSeverity
    dedupeKey    String
    message      String
    context      Json
    createdAt    DateTime      @default(now())
    resolvedAt   DateTime?
    resolvedById String?

    @@map("operational_alerts")
}

model TreasuryOperation {
    id            String           @id @default(cuid())
    key           String           @unique
    kind          TreasuryOpKind
    provider      ProviderId
    chain         String
    amountUsd     BigInt
    amountUsdc    BigInt?
    status        TreasuryOpStatus @default(planned)
    externalRef   String?
    failureReason String?
    providerMode  ProviderMode
    createdAt     DateTime         @default(now())
    updatedAt     DateTime         @updatedAt

    @@map("treasury_operations")
}

model ReconciliationRun {
    id        String      @id @default(cuid())
    asOf      DateTime
    status    ReconStatus
    results   Json
    createdAt DateTime    @default(now())

    @@map("reconciliation_runs")
}

model ProviderHealth {
    provider            ProviderId @id
    consecutiveFailures Int        @default(0)
    lastFailureAt       DateTime?
    lastSuccessAt       DateTime?
    openUntil           DateTime?

    @@map("provider_health")
}

model SimRampTx {
    id                       String          @id @default(cuid())
    provider                 ProviderId
    key                      String
    kind                     String
    direction                OrderDirection?
    state                    String
    ngnAmount                BigInt?
    usdAmount                BigInt
    feeNgn                   BigInt?
    rateKobo                 BigInt?
    rateMicroUsd             BigInt?
    sourceAccountNumber      String?
    sourceAccountName        String?
    senderName               String?
    destinationAccountNumber String?
    bankReference            String?
    chain                    String?
    recipientAddress         String?
    fundingAddress           String?
    settleAt                 DateTime?
    expiresAt                DateTime?
    outcome                  String?
    createdAt                DateTime        @default(now())
    updatedAt                DateTime        @updatedAt

    @@unique([provider, key])
    @@map("sim_ramp_txs")
}

model SimChainTx {
    id            String   @id @default(cuid())
    key           String   @unique
    chain         String
    hash          String   @unique
    fromAddress   String
    toAddress     String
    token         String
    amount        Decimal  @db.Decimal(78, 0)
    status        String
    confirmAt     DateTime
    failureReason String?
    createdAt     DateTime @default(now())

    @@map("sim_chain_txs")
}

model SimSwap {
    id            String    @id @default(cuid())
    key           String    @unique
    venueId       String
    stockId       String
    side          TradeSide
    amountIn      Decimal  @db.Decimal(78, 0)
    minAmountOut  Decimal  @db.Decimal(78, 0)
    amountOut     Decimal? @db.Decimal(78, 0)
    status        String
    settleAt      DateTime
    failureReason String?
    createdAt     DateTime  @default(now())

    @@map("sim_swaps")
}

model SimFault {
    id         String    @id @default(cuid())
    scope      String
    key        String
    consumedAt DateTime?
    createdAt  DateTime  @default(now())

    @@unique([scope, key])
    @@map("sim_faults")
}

model OnchainNetwork {
    id           String          @id @default(cuid())
    networkId    String          @unique
    chainId      Int
    kind         IntegrationKind
    genesisHash  String?
    deploymentId String          @unique
    label        String
    rpcLoopback  Boolean         @default(true)
    finalizedBlock Decimal?      @db.Decimal(78, 0)
    createdAt    DateTime        @default(now())

    stocks     Stock[]
    operations OnchainOperation[]
    receipts   RewardReceipt[]
    actions    StockAction[]

    @@map("onchain_networks")
}

model CustodyProfile {
    id                String           @id @default(cuid())
    kind              CustodyKind
    label             String
    walletId          String?
    externalProfileId String?
    managedAddress    String?
    deploymentId      String?
    createdAt         DateTime         @default(now())

    operations OnchainOperation[]

    @@unique([kind, walletId])
    @@map("custody_profiles")
}

// Private exact signed payload for local beta wallet transfers. Never serialized.
model LocalChainTransfer {
    id           String @id @default(cuid())
    key          String @unique
    deploymentId String
    requestHash  String
    nonce        Int
    txHash       String
    signedTx     String
    createdAt    DateTime @default(now())

    @@index([deploymentId, nonce])
    @@map("local_chain_transfers")
}

model InvestmentAuthorization {
    id            String    @id @default(cuid())
    userId        String
    key           String    @unique
    kind              AuthKind
    // one_time: bound to one owned persisted quote; all limits resolve from it.
    quoteKind         String?
    quoteId           String?
    // standing: explicit non-empty asset scopes and allowed actions.
    stockIds          String[]
    strategyIds       String[]
    actions           String[]
    maxActionNgn      Decimal?  @db.Decimal(78, 0)
    maxTotalNgn       Decimal?  @db.Decimal(78, 0)
    maxFeeBps         Int?
    maxSlippageBps    Int?
    expiresAt         DateTime
    revokedAt     DateTime?
    epoch         Int       @default(0)
    policyVersion     String
    disclosureVersion String?
    betaContext       Json?
    requestHash       String
    createdAt         DateTime  @default(now())

    investments    Investment[]
    strategyQuotes StrategyQuote[]

    @@index([userId])
    @@map("investment_authorizations")
}

model InvestmentQuote {
    id                String    @id @default(cuid())
    userId            String
    stockId           String
    side              TradeSide
    inputAsset        String
    inputRaw          Decimal   @db.Decimal(78, 0)
    outputAsset       String
    expectedOutputRaw Decimal   @db.Decimal(78, 0)
    minOutputRaw      Decimal   @db.Decimal(78, 0)
    budgetNgn         BigInt?
    allowPartialFill  Boolean   @default(false)
    slippageBps       Int       @default(100)
    feeUsdc           Decimal   @db.Decimal(78, 0)
    fxFeeUsdc         Decimal   @db.Decimal(78, 0) @default(0)
    venueFeeUsdc      Decimal   @db.Decimal(78, 0) @default(0)
    venueFeeAsset     String?
    venueFeeRaw       Decimal?  @db.Decimal(78, 0)
    priceImpactBps    Int
    providerId        String
    providerVersion   String
    context           Json
    expiresAt         DateTime
    consumedAt        DateTime?
    sourceBlock       Decimal   @db.Decimal(78, 0)
    routeFingerprint  String
    createdAt         DateTime  @default(now())

    investment Investment?

    @@index([userId])
    @@map("investment_quotes")
}

model Investment {
    id              String               @id @default(cuid())
    key             String               @unique
    requestHash     String
    userId          String
    quoteId         String?              @unique
    quote           InvestmentQuote?     @relation(fields: [quoteId], references: [id])
    authorizationId String?
    authorization   InvestmentAuthorization? @relation(fields: [authorizationId], references: [id])
    stockId         String
    side            TradeSide
    purpose         TradePurpose         @default(deposit_buy)
    orderId         String?
    status          InvestmentStatus     @default(quoted)
    operationId     String?              @unique
    operation       OnchainOperation?    @relation(fields: [operationId], references: [id])
    trade           TradeOrder?
    amountIn        Decimal              @db.Decimal(78, 0)
    amountOut       Decimal?             @db.Decimal(78, 0)
    minAmountOut    Decimal?             @db.Decimal(78, 0)
    failureReason   String?
    holdReason      String?
    createdAt       DateTime             @default(now())
    updatedAt       DateTime             @updatedAt

    @@index([userId])
    @@index([status])
    @@map("investments")
}

model OnchainOperation {
    id                    String         @id @default(cuid())
    key                   String         @unique
    requestHash           String
    kind                  OperationKind
    userId                String
    walletId              String
    custodyProfileId      String
    custodyProfile        CustodyProfile @relation(fields: [custodyProfileId], references: [id])
    networkId             String
    network               OnchainNetwork @relation(fields: [networkId], references: [id])
    providerId            String
    quoteId               String?
    authorizationId       String?
    status                OperationStatus @default(pending)
    nonce                 Int?
    relayerNonce          Int?
    signedPayloadHash     String?
    txHash                String?
    blockHash             String?
    blockNumber           Decimal?       @db.Decimal(78, 0)
    requiredConfirmations Int            @default(2)
    fingerprint           String
    expected              Json?
    actual                Json?
    errorReason           String?
    createdAt             DateTime       @default(now())
    updatedAt             DateTime       @updatedAt

    steps        OnchainStep[]
    observations ChainObservation[]
    investment   Investment?
    position     StrategyPosition?

    @@index([userId])
    @@index([status])
    @@map("onchain_operations")
}

model OnchainStep {
    id          String         @id @default(cuid())
    operationId String
    operation   OnchainOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
    index       Int
    to          String
    callHash    String
    status      StepStatus     @default(pending)
    txHash      String?
    createdAt   DateTime       @default(now())

    @@unique([operationId, index])
    @@map("onchain_steps")
}

model ChainObservation {
    id           String          @id @default(cuid())
    operationId  String
    operation    OnchainOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
    txHash       String?
    blockHash    String?
    blockNumber  Decimal?        @db.Decimal(78, 0)
    state        ObsState
    gasCostWei   Decimal?        @db.Decimal(78, 0)
    actualInput  Json?
    actualOutput Json?
    deltas       Json?
    observedAt   DateTime        @default(now())

    @@index([operationId])
    @@map("chain_observations")
}

model StockAction {
    id            String          @id @default(cuid())
    networkId     String
    network       OnchainNetwork  @relation(fields: [networkId], references: [id])
    stockId       String
    kind          String
    txHash        String
    logIndex      Int
    blockNumber   Decimal         @db.Decimal(78, 0)
    blockHash     String?
    orphanedAt    DateTime?
    multiplierWad Decimal?        @db.Decimal(78, 0)
    effectiveAt   DateTime?
    cancelledAt   DateTime?
    payload       Json?
    createdAt     DateTime        @default(now())

    @@unique([networkId, txHash, logIndex])
    @@index([stockId])
    @@map("stock_actions")
}

model PositionLot {
    id         String    @id @default(cuid())
    userId     String
    stockId    String
    asset      String
    operationId String?
    quantity     Decimal   @db.Decimal(78, 0)
    costUsdc     Decimal   @db.Decimal(78, 0)
    realizedUsdc Decimal   @db.Decimal(78, 0) @default(0)
    fxRateKobo   BigInt?
    source       String
    openedAt     DateTime  @default(now())
    closedAt     DateTime?

    @@index([userId, stockId])
    @@map("position_lots")
}

model Strategy {
    id                String   @id @default(cuid())
    providerId        String
    key               String   @unique
    name              String
    version           String
    disclosureVersion String
    inputAssets       Json
    receiptAsset      String
    rewardAssets      Json
    separateClaim     Boolean  @default(false)
    permanentLock     Boolean  @default(false)
    capBps            Int      @default(2000)
    maxUsdEquivalent  Decimal  @db.Decimal(78, 0)
    enabled           Boolean  @default(true)
    experimental      Boolean  @default(false)
    provenance        Json
    createdAt         DateTime @default(now())

    positions StrategyPosition[]
    quotes    StrategyQuote[]

    @@map("strategies")
}

model StrategyPosition {
    id            String                 @id @default(cuid())
    userId        String
    strategyId    String
    strategy      Strategy               @relation(fields: [strategyId], references: [id])
    operationId   String?                @unique
    operation     OnchainOperation?      @relation(fields: [operationId], references: [id])
    state         StrategyPositionState  @default(reserved)
    receiptRaw    Decimal                @db.Decimal(78, 0) @default(0)
    // Provider position NFT id (e.g. Hydrex); null for replica positions.
    externalTokenId Decimal?             @db.Decimal(78, 0)
    principalUsdc Decimal                @db.Decimal(78, 0) @default(0)
    valueUsdc     Decimal?               @db.Decimal(78, 0)
    createdAt     DateTime               @default(now())
    updatedAt     DateTime               @updatedAt

    @@index([userId])
    @@map("strategy_positions")
}

model StrategyQuote {
    id                String                 @id @default(cuid())
    userId            String
    strategyId        String
    strategy          Strategy               @relation(fields: [strategyId], references: [id])
    positionId        String?
    action            String
    maximumInputs     Json
    minimumOutputs    Json
    userFeeUsdc       Decimal                @db.Decimal(78, 0) @default(0)
    expiresAt         DateTime
    consumedAt        DateTime?
    strategyVersion   String
    disclosureVersion String
    fingerprint       String
    authorizationId   String?
    authorization     InvestmentAuthorization? @relation(fields: [authorizationId], references: [id])
    context           Json?
    createdAt         DateTime               @default(now())

    @@index([userId])
    @@map("strategy_quotes")
}

model RewardReceipt {
    id                    String          @id @default(cuid())
    networkId             String
    network               OnchainNetwork  @relation(fields: [networkId], references: [id])
    source                RewardSource
    sourceRef             String?
    txHash                String?
    logIndex              Int?
    beneficiary           String
    asset                 String
    amountRaw             Decimal         @db.Decimal(78, 0)
    accrualPeriod         String?
    week                  String?
    state                 ReceiptState    @default(estimated)
    conversionOperationId String?
    conversionQuoteId     String?
    conversionAuthorizationId String?
    payoutOrderId         String?
    reinvestTradeId       String?
    createdAt             DateTime        @default(now())
    updatedAt             DateTime        @updatedAt

    allocation EarningAllocation?

    @@unique([networkId, source, txHash, logIndex, beneficiary, asset], map: "reward_receipt_event_asset_key")
    @@index([beneficiary])
    @@map("reward_receipts")
}

model EarningAllocation {
    id              String          @id @default(cuid())
    receiptId       String          @unique
    receipt         RewardReceipt   @relation(fields: [receiptId], references: [id])
    week            String
    userId          String
    amountUsdc      Decimal         @db.Decimal(78, 0)
    state           AllocationState @default(reserved)
    payoutOrderId   String?
    reinvestTradeId String?
    createdAt       DateTime        @default(now())

    @@index([userId, week])
    @@map("earning_allocations")
}

model SponsorBudget {
    id          String   @id @default(cuid())
    scope       String   @unique
    windowStart DateTime
    spentWei    Decimal  @db.Decimal(78, 0) @default(0)
    capWei      Decimal  @db.Decimal(78, 0)

    @@map("sponsor_budgets")
}

// Private, never exposed through APIs/logs: lets a crash replay the exact signed
// bytes instead of creating a replacement economic action.
model SignedPayload {
    id           String   @id @default(cuid())
    operationId  String   @unique
    approveTx    String
    executeTx    String
    approveHash  String
    executeHash  String
    createdAt    DateTime @default(now())

    @@map("signed_payloads")
}
